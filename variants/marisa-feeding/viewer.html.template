iant-numeric:tabular-nums}.bar{height:8px;background:#e0e5d7;border-radius:5px;margin:8px 0 16px;overflow:hidden}.bar span{display:block;height:100%;background:#8aab74;width:0;transition:width .2s}.bar.gold span{background:#c99853}.actions{display:grid;gap:9px}.primary{background:#4e7359;color:#fff;border-color:#4e7359}.primary:hover{background:#3d634a}.secondary{font-size:13px}.status{background:#e9efdf;padding:9px 12px;border-radius:7px;margin-bottom:14px;font-size:14px}.transport{display:flex;gap:8px}.transport button{flex:1;font-size:13px;padding:7px}.speed{display:flex;align-items:center;gap:8px;font-size:13px;margin-top:15px}.speed input{width:100%;accent-color:#5e815c}.note{font-size:12px;color:#7b8671;margin:12px 0 0}.files{display:flex;gap:13px;flex-wrap:wrap;margin-top:10px}a{color:#5e7950;text-underline-offset:3px;font-size:12px}footer{padding:0 26px 20px;color:#7a8371;font-size:12px}#error{display:none;position:absolute;inset:120px 30px auto;padding:25px;background:#fff4d8;border-radius:12px} @media(max-width:780px){header{padding:16px}h1{font-size:21px}main{grid-template-columns:1fr;padding:12px}.stage{height:470px;min-height:400px}aside{display:grid;grid-template-columns:1fr 1fr}.card{padding:15px}.hint{display:none}}@media(max-width:480px){aside{grid-template-columns:1fr}.stage{height:440px}.badge{display:none}.speech{font-size:13px}.camera{left:10px;gap:4px}.camera button{padding:6px 9px}}
