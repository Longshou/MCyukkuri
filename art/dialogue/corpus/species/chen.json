    {
      "id": "ran_address",
      "zh": "蓝大人／蓝大银",
      "ja": "藍さま",
      "en": "Ran-sama",
      "basis": ["F74", "P"],
      "status": "candidate",
      "kind": "relationship_address",
      "notes": "Original Chinese forms; the name does not imply that Ran exists in the project."
    },
    {
      "id": "phonetic_overrides",
      "zh": "橙的理解／不理解词形成幼分开；不懂时不能用肯定口癖。",
      "ja": "理解・不理解の語形を成幼で分け、不理解に肯定語尾を使わない。",
      "en": "Keep Chen's get-it forms stage-specific; never use the affirmative form while confused.",
      "basis": ["E04", "E06", "P"],
      "status": "rule",
      "data": {"adult": {"positive": "瓦卡鲁哟", "negative": "瓦卡拉奈哟"}, "baby": {"positive": "瓦卡呜哟", "negative": "瓦卡呐奈哟"}, "semantic_consistency": true}
    },
    {
      "id": "address_forms",
      "zh": "普通称呼按真实关系使用，蓝大人只在相应关系存在时使用。",
      "ja": "通常の呼称は実関係で選び、藍さまも対応する関係がある時だけ使う。",
      "en": "Use ordinary relationship addresses; Ran-sama only where that relationship actually exists.",
      "basis": ["L36", "F74", "P"],
      "status": "rule",
      "data": {"common_ref": "common.address_forms", "ran_requires_actual_character": true}
    },
    {
      "id": "lexical_preferences",
      "zh": "有限短句可配合视线与尾部动作；橙并不承担固定聚落职责。",
      "ja": "短い文を視線と尾の動作で補い、集落の固定職には置かない。",
      "en": "Short lines may be supported by gaze and tails; Chen has no fixed settlement duty.",
      "basis": ["L03", "F74", "P"],
      "status": "rule",
      "data": {"nonverbal_channels": ["gaze", "tail"], "fixed_role": false}
    },
